---
import { Icon } from 'astro-icon/components';
import { PROJECT_STATUS } from '@/utils/content';

interface Props {
  project: {
    id: string;
    data: {
      name: string;
      description: string;
      status: string;
      tech: string[];
      url?: string;
      repo?: string;
      cover?: string;
    };
  };
}

const { project } = Astro.props;
const status = PROJECT_STATUS[project.data.status] ?? PROJECT_STATUS.wip;
const hasCover = Boolean(project.data.cover);
---

<article
  class="group flex flex-col overflow-hidden rounded-xl border border-zinc-200/70 bg-white transition-all duration-200 hover:-translate-y-0.5 hover:border-zinc-300 hover:shadow-md dark:border-zinc-800/70 dark:bg-zinc-900 dark:hover:border-zinc-700 dark:hover:shadow-zinc-950/50"
>
  <!-- 封面 / 占位 -->
  {
    hasCover ? (
      <a href={project.data.url ?? `#${project.id}`} class="block overflow-hidden">
        <img
          src={project.data.cover}
          alt={`${project.data.name} 封面`}
          class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
          loading="lazy"
        />
      </a>
    ) : (
      <a
        href={project.data.url ?? `#${project.id}`}
        class="flex aspect-video w-full items-center justify-center bg-gradient-to-br from-zinc-50 to-zinc-100 dark:from-zinc-900 dark:to-zinc-800"
        aria-label={project.data.name}
      >
        <Icon
          name="lucide:app-window"
          class="h-10 w-10 text-zinc-300 transition-colors group-hover:text-brand-400 dark:text-zinc-700"
        />
      </a>
    )
  }

  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-center justify-between gap-2">
      <h2 class="text-lg font-semibold tracking-tight">
        <a
          href={project.data.url ?? `#${project.id}`}
          class="text-zinc-900 transition-colors group-hover:text-brand-600 dark:text-zinc-100 dark:group-hover:text-brand-400"
        >
          {project.data.name}
        </a>
      </h2>
      <span class={`shrink-0 rounded-full border px-2 py-0.5 text-xs font-medium ${status.class}`}>
        {status.label}
      </span>
    </div>

    <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">
      {project.data.description}
    </p>

    {
      project.data.tech.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {project.data.tech.map((t) => (
            <span class="rounded bg-zinc-100 px-1.5 py-0.5 font-mono text-xs text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400">
              {t}
            </span>
          ))}
        </div>
      )
    }

    <div class="mt-4 flex flex-1 items-end gap-2 pt-2">
      {
        project.data.url && (
          <a
            href={project.data.url}
            class="inline-flex items-center gap-1.5 rounded-md bg-gradient-to-r from-brand-600 to-brand-500 px-3 py-1.5 text-sm font-medium text-white transition-colors hover:bg-gradient-to-r from-brand-600 to-brand-500 dark:bg-gradient-to-r from-brand-600 to-brand-500 dark:hover:bg-brand-400"
          >
            <Icon name="lucide:external-link" class="h-4 w-4" />
            访问网站
          </a>
        )
      }
      {
        project.data.repo && (
          <a
            href={project.data.repo}
            class="inline-flex items-center gap-1.5 rounded-md border border-zinc-200 px-3 py-1.5 text-sm font-medium text-zinc-700 transition-colors hover:border-zinc-300 hover:bg-zinc-50 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-600 dark:hover:bg-zinc-800"
          >
            <Icon name="lucide:github" class="h-4 w-4" />
            源码
          </a>
        )
      }
    </div>
  </div>
</article>
