---
import { Icon } from 'astro-icon/components';

interface Props {
  nav: { label: string; href: string }[];
  siteName: string;
}

const { nav, siteName } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header
  class="sticky top-0 z-40 border-b border-zinc-200/70 bg-white/80 backdrop-blur-md transition-colors dark:border-zinc-800/70 dark:bg-zinc-950/80"
>
  <div class="mx-auto flex h-16 max-w-4xl items-center justify-between px-4 sm:px-6">
    <!-- 品牌 -->
    <a
      href="/"
      class="group flex items-center gap-2 text-lg font-semibold tracking-tight text-zinc-900 transition-colors dark:text-zinc-100"
    >
      <span
        class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-rose-500 via-fuchsia-500 to-violet-500 text-base font-bold text-white shadow-md shadow-rose-500/30 transition-transform duration-300 group-hover:scale-110 group-hover:rotate-6"
        aria-hidden="true"
      >
        L
      </span>
      <span class="hidden font-display sm:inline">{siteName}</span>
    </a>

    <!-- 桌面端导航 -->
    <nav class="hidden items-center gap-1 md:flex" aria-label="主导航">
      {
        nav.map((item) => {
          const active =
            item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                'rounded-md px-3 py-1.5 text-sm font-medium transition-colors',
                active
                  ? 'bg-zinc-100 text-zinc-900 dark:bg-zinc-800 dark:text-zinc-100'
                  : 'text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-1">
      <!-- 登录 / 博主状态 -->
      <div id="auth-area" class="mr-1 flex items-center">
        <button
          id="login-btn"
          type="button"
          class="rounded-md px-3 py-1.5 text-sm font-medium text-zinc-600 transition-colors hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800"
        >登录</button>
      </div>
      <!-- 主题切换 -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="切换亮暗模式"
        class="flex h-9 w-9 items-center justify-center rounded-md text-zinc-500 transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
      >
        <Icon name="lucide:sun" class="h-[1.15rem] w-[1.15rem] dark:hidden" />
        <Icon name="lucide:moon" class="hidden h-[1.15rem] w-[1.15rem] dark:block" />
      </button>

      <!-- 移动端菜单按钮 -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="打开菜单"
        aria-expanded="false"
        class="flex h-9 w-9 items-center justify-center rounded-md text-zinc-500 transition-colors hover:bg-zinc-100 hover:text-zinc-900 md:hidden dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
      >
        <Icon name="lucide:menu" class="h-5 w-5" />
      </button>
    </div>
  </div>

  <!-- 移动端导航抽屉 -->
  <nav
    id="mobile-menu"
    class="hidden border-t border-zinc-200/70 bg-white px-4 pb-4 pt-2 md:hidden dark:border-zinc-800/70 dark:bg-zinc-950"
    aria-label="移动端导航"
  >
    {
      nav.map((item) => {
        const active =
          item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
        return (
          <a
            href={item.href}
            class:list={[
              'block rounded-md px-3 py-2 text-sm font-medium transition-colors',
              active
                ? 'bg-zinc-100 text-zinc-900 dark:bg-zinc-800 dark:text-zinc-100'
                : 'text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100',
            ]}
          >
            {item.label}
          </a>
        );
      })
    }
  </nav>

  <!-- 博主登录弹窗 -->
  <div
    id="login-modal"
    class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4"
  >
    <div class="w-full max-w-xs rounded-2xl border border-zinc-200 bg-white p-5 shadow-xl dark:border-zinc-700 dark:bg-zinc-900">
      <div class="flex items-center justify-between">
        <h3 class="font-medium text-zinc-800 dark:text-zinc-100">博主登录</h3>
        <button
          id="login-close"
          type="button"
          aria-label="关闭"
          class="text-zinc-400 transition-colors hover:text-zinc-600 dark:hover:text-zinc-200"
        >✕</button>
      </div>
      <input
        id="login-password"
        type="password"
        placeholder="输入管理密码"
        class="mt-3 w-full rounded-lg border border-zinc-200 bg-transparent px-3 py-2 text-sm outline-none focus:border-zinc-400 dark:border-zinc-800 dark:placeholder:text-zinc-600"
      />
      <button
        id="login-submit"
        type="button"
        class="mt-3 w-full rounded-lg bg-gradient-to-r from-rose-500 to-fuchsia-500 px-4 py-2 text-sm font-medium text-white transition hover:opacity-90"
      >登录</button>
      <p id="login-msg" class="mt-2 h-4 text-xs text-red-500"></p>
    </div>
  </div>
</header>

<script>
  // 主题切换
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // 移动端菜单
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });

  // —— 登录态（客户端探测，所有页面通用）——
  const authArea = document.getElementById('auth-area');
  const loginModal = document.getElementById('login-modal');

  async function renderAuth() {
    if (!authArea) return;
    try {
      const res = await fetch('/app/me');
      const data = await res.json().catch(() => ({ authed: false }));
      if (data.authed) {
        authArea.innerHTML = '';
        const badge = document.createElement('span');
        badge.className =
          'inline-flex items-center gap-1 rounded-full bg-gradient-to-r from-rose-500 to-fuchsia-500 px-2.5 py-1 text-xs font-medium text-white';
        badge.textContent = '博主';
        const logout = document.createElement('button');
        logout.type = 'button';
        logout.className =
          'ml-2 text-sm text-zinc-500 transition-colors hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-200';
        logout.textContent = '退出';
        logout.addEventListener('click', async () => {
          await fetch('/app/logout', { method: 'POST' });
          location.reload();
        });
        authArea.appendChild(badge);
        authArea.appendChild(logout);
      }
    } catch {
      /* 忽略：保持默认登录按钮 */
    }
  }
  renderAuth();

  // —— 登录弹窗 ——
  const loginBtn = document.getElementById('login-btn');
  const loginClose = document.getElementById('login-close');
  const loginSubmit = document.getElementById('login-submit');
  const loginPw = document.getElementById('login-password');
  const loginMsg = document.getElementById('login-msg');

  loginBtn?.addEventListener('click', () => loginModal?.classList.remove('hidden'));
  loginClose?.addEventListener('click', () => loginModal?.classList.add('hidden'));
  loginModal?.addEventListener('click', (e) => {
    if (e.target === loginModal) loginModal.classList.add('hidden');
  });
  loginPw?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') loginSubmit?.click();
  });
  loginSubmit?.addEventListener('click', async () => {
    if (!loginPw || !loginMsg || !loginSubmit) return;
    const pw = loginPw.value;
    loginSubmit.disabled = true;
    loginMsg.textContent = '';
    try {
      const res = await fetch('/app/login', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ password: pw }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.ok) {
        location.reload();
        return;
      }
      loginMsg.textContent = data.error || '登录失败';
    } catch {
      loginMsg.textContent = '网络错误';
    }
    loginSubmit.disabled = false;
  });
</script>
