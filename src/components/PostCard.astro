---
import { Icon } from 'astro-icon/components';
import { formatDate, readingTime } from '@/utils/content';
import { tagStyle, resolveTags } from '@/utils/tags';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      tags: string[];
    };
    body?: string;
  };
}

const { post } = Astro.props;
const minutes = readingTime(post.body ?? '');
// 分类：手动修正优先（见 src/data/tagOverrides.ts）
const tags = resolveTags(post.id, post.data.tags);
---

<article
  class="blog-item group relative overflow-hidden rounded-2xl border border-zinc-200/70 bg-white p-5 transition-all duration-300 hover:-translate-y-1 hover:border-brand-300 hover:shadow-lg hover:shadow-brand-500/10 sm:p-6 dark:border-zinc-800/70 dark:bg-zinc-900 dark:hover:border-brand-500/40 dark:hover:shadow-brand-500/5"
  data-tags={tags.join(',')}
  data-title={post.data.title.toLowerCase()}
  data-desc={post.data.description.toLowerCase()}
>
  <!-- 悬停时从顶部滑入的品牌色渐变条 -->
  <span
    class="absolute inset-x-0 top-0 h-0.5 bg-gradient-to-r from-brand-700 via-brand-500 to-brand-300 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
    aria-hidden="true"
  ></span>

  <div class="flex items-center gap-3 text-xs text-zinc-400 dark:text-zinc-500">
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
    <span>·</span>
    <span class="flex items-center gap-1">
      <Icon name="lucide:clock" class="h-3.5 w-3.5" />
      {minutes} 分钟
    </span>
  </div>

  <h2 class="mt-2 font-display text-lg tracking-tight sm:text-xl">
    <a
      href={`/blog/${post.id}/`}
      class="text-zinc-900 transition-colors group-hover:text-brand-600 dark:text-zinc-100 dark:group-hover:text-brand-400"
    >
      {post.data.title}
    </a>
  </h2>

  <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">
    {post.data.description}
  </p>

  {
    tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span
            class:list={[
              'rounded-full border px-2.5 py-0.5 text-xs font-medium',
              tagStyle(tag),
            ]}
          >
            #{tag}
          </span>
        ))}
      </div>
    )
  }
</article>
