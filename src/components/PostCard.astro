---
import { Icon } from 'astro-icon/components';
import { SOCIAL, SITE } from '@/config';
import { formatDate, readingTime } from '@/utils/content';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      tags: string[];
    };
    body?: string;
  };
}

const { post } = Astro.props;
const minutes = readingTime(post.body ?? '');
---

<article
  class="blog-item group rounded-xl border border-zinc-200/70 bg-white p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-zinc-300 hover:shadow-md sm:p-6 dark:border-zinc-800/70 dark:bg-zinc-900 dark:hover:border-zinc-700 dark:hover:shadow-zinc-950/50"
  data-tags={post.data.tags.join(',')}
  data-title={post.data.title.toLowerCase()}
  data-desc={post.data.description.toLowerCase()}
>
  <div class="flex items-center gap-3 text-xs text-zinc-400 dark:text-zinc-500">
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
    <span>·</span>
    <span class="flex items-center gap-1">
      <Icon name="lucide:clock" class="h-3.5 w-3.5" />
      {minutes} 分钟
    </span>
  </div>

  <h2 class="mt-2 text-lg font-semibold tracking-tight sm:text-xl">
    <a
      href={`/blog/${post.id}/`}
      class="text-zinc-900 transition-colors group-hover:text-indigo-600 dark:text-zinc-100 dark:group-hover:text-indigo-400"
    >
      {post.data.title}
    </a>
  </h2>

  <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">
    {post.data.description}
  </p>

  {
    post.data.tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {post.data.tags.map((tag) => (
          <span class="rounded-full border border-zinc-200 bg-zinc-50 px-2 py-0.5 text-xs text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400">
            #{tag}
          </span>
        ))}
      </div>
    )
  }
</article>
