---
import { Icon } from 'astro-icon/components';
import { SOCIAL } from '@/config';

const links = [
  { href: SOCIAL.github, icon: 'lucide:github', label: 'GitHub' },
  { href: SOCIAL.email, icon: 'lucide:mail', label: 'Email' },
  { href: SOCIAL.scholar, icon: 'lucide:graduation-cap', label: 'Google Scholar' },
  { href: SOCIAL.x, icon: 'lucide:twitter', label: 'X (Twitter)' },
];
---

<div class="flex items-center gap-2">
  {
    links.map((link) => (
      <a
        href={link.href}
        target={link.href.startsWith('http') ? '_blank' : undefined}
        rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        aria-label={link.label}
        title={link.label}
        class="flex h-9 w-9 items-center justify-center rounded-md border border-zinc-200 bg-white text-zinc-500 transition-all hover:-translate-y-0.5 hover:border-rose-300 hover:text-rose-600 hover:shadow-sm dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400 dark:hover:border-rose-700 dark:hover:text-rose-400"
      >
        <Icon name={link.icon} class="h-[1.15rem] w-[1.15rem]" />
      </a>
    ))
  }
</div>
