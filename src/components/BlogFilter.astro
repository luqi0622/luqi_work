---
/**
 * 博客列表筛选：标签 chips + 关键词搜索（纯客户端过滤，无需框架）
 */
import { Icon } from 'astro-icon/components';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="mb-8 space-y-4">
  <!-- 关键词搜索 -->
  <div class="relative">
    <Icon
      name="lucide:search"
      class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-zinc-400"
    />
    <input
      id="blog-search"
      type="search"
      placeholder="搜索随笔标题或摘要…"
      autocomplete="off"
      class="w-full rounded-lg border border-zinc-200 bg-white py-2 pl-9 pr-4 text-sm text-zinc-700 placeholder-zinc-400 transition-colors focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-100 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-200 dark:placeholder-zinc-500 dark:focus:border-indigo-600 dark:focus:ring-indigo-950"
    />
  </div>

  <!-- 标签筛选 -->
  <div class="flex flex-wrap items-center gap-2" role="group" aria-label="标签筛选">
    <button
      type="button"
      data-tag-filter=""
      class="tag-chip rounded-full border border-zinc-200 bg-white px-3 py-1 text-sm text-zinc-600 transition-colors hover:border-indigo-300 hover:text-indigo-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400 dark:hover:border-indigo-700 dark:hover:text-indigo-400"
    >
      全部
    </button>
    {
      tags.map((tag) => (
        <button
          type="button"
          data-tag-filter={tag}
          class="tag-chip rounded-full border border-zinc-200 bg-white px-3 py-1 text-sm text-zinc-600 transition-colors hover:border-indigo-300 hover:text-indigo-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400 dark:hover:border-indigo-700 dark:hover:text-indigo-400"
        >
          #{tag}
        </button>
      ))
    }
  </div>

  <p id="blog-empty" class="hidden py-12 text-center text-sm text-zinc-400 dark:text-zinc-500">
    没有找到匹配的随笔
  </p>
</div>

<script>
  let activeTag = '';
  let keyword = '';

  const items = Array.from(document.querySelectorAll<HTMLElement>('.blog-item'));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tag-filter]'));
  const input = document.querySelector<HTMLInputElement>('#blog-search');
  const empty = document.querySelector('#blog-empty');

  function applyChipStyles() {
    for (const chip of chips) {
      const isActive = (chip.dataset.tagFilter ?? '') === activeTag;
      chip.classList.toggle('border-indigo-400', isActive);
      chip.classList.toggle('text-indigo-600', isActive);
      chip.classList.toggle('bg-indigo-50', isActive);
      chip.classList.toggle('dark:border-indigo-600', isActive);
      chip.classList.toggle('dark:text-indigo-400', isActive);
      chip.classList.toggle('dark:bg-indigo-950', isActive);
      chip.setAttribute('aria-pressed', String(isActive));
    }
  }

  function filter() {
    let visible = 0;
    for (const item of items) {
      const tags = (item.dataset.tags ?? '').split(',').filter(Boolean);
      const text = `${item.dataset.title ?? ''} ${item.dataset.desc ?? ''}`;
      const matchTag = activeTag === '' || tags.includes(activeTag);
      const matchKeyword = keyword === '' || text.includes(keyword.toLowerCase());
      const show = matchTag && matchKeyword;
      item.classList.toggle('hidden', !show);
      if (show) visible++;
    }
    empty?.classList.toggle('hidden', visible > 0);
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      activeTag = chip.dataset.tagFilter ?? '';
      applyChipStyles();
      filter();
    });
  }

  input?.addEventListener('input', () => {
    keyword = input.value.trim();
    filter();
  });
</script>
