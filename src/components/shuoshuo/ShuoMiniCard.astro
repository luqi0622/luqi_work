---
import { formatBeijing } from '@/utils/time';
import type { Post, ReactionKind } from '@/lib/queries';

interface Props {
  post: Post;
  tags?: string[];
  reactions?: Record<ReactionKind, number>;
}
const { post, tags = [], reactions } = Astro.props;
const content = post.content.trim();
const preview = content.length > 120 ? content.slice(0, 120) + '…' : content;
const dateStr = formatBeijing(post.t);

const like = reactions?.like ?? 0;
const resonate = reactions?.resonate ?? 0;
const commentCount = post.comments.length;
---
<article
  class="card-hover group relative flex flex-col overflow-hidden rounded-2xl border border-zinc-200/70 bg-white p-5 transition-all duration-300 hover:-translate-y-1 hover:border-brand-300 hover:shadow-lg hover:shadow-brand-500/10 dark:border-zinc-800/70 dark:bg-zinc-900/40 dark:hover:border-brand-500/40 dark:hover:shadow-brand-500/5"
  data-post-id={post.id}
>
  <!-- 悬停时从顶部滑入的品牌色渐变条 -->
  <span
    class="absolute inset-x-0 top-0 h-0.5 bg-gradient-to-r from-brand-700 via-brand-500 to-brand-300 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
    aria-hidden="true"
  ></span>

  <div class="flex items-center gap-2 text-xs text-zinc-400 dark:text-zinc-500">
    <time datetime={dateStr}>{dateStr}</time>
    {
      post.pinned === 1 && (
        <span class="inline-flex items-center rounded bg-amber-100 px-1.5 py-0.5 text-xs font-medium text-amber-700 dark:bg-amber-500/15 dark:text-amber-400">
          置顶
        </span>
      )
    }
  </div>

  <p class="mt-2 line-clamp-3 text-[15px] leading-relaxed text-zinc-800 dark:text-zinc-200">
    {preview || '［ 仅配图 ］'}
  </p>

  {
    tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {tags.map((t) => (
          <span class="rounded-full bg-brand-50 px-2 py-0.5 text-xs text-brand-700 dark:bg-brand-500/10 dark:text-brand-300">
            #{t}
          </span>
        ))}
      </div>
    )
  }

  <div
    class="mt-3 flex items-center justify-between gap-2 text-xs text-zinc-400 dark:text-zinc-500"
  >
    <div class="flex items-center gap-3">
      {
        commentCount > 0 && (
          <span class="inline-flex items-center gap-1">💬 {commentCount}</span>
        )
      }
      {
        like > 0 && (
          <span class="inline-flex items-center gap-1">👍 {like}</span>
        )
      }
      {
        resonate > 0 && (
          <span class="inline-flex items-center gap-1">❤️ {resonate}</span>
        )
      }
    </div>
    <a
      href={`/blog#post-${post.id}`}
      class="inline-flex items-center gap-1 font-medium text-brand-600 transition-colors hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300"
    >
      查看详情
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
