---
/**
 * 逻辑电路实验台
 *
 * 纯前端工具：拖拽门电路 → 连线 → 实时看真值表与布尔表达式
 * 逻辑引擎在 src/lib/logic/（纯函数，可单测），画布控制器是 LogicBench
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';

const GATES = [
  { kind: 'AND', label: '与门', hint: '全 1 才 1' },
  { kind: 'OR', label: '或门', hint: '有 1 就 1' },
  { kind: 'NOT', label: '非门', hint: '取反' },
  { kind: 'NAND', label: '与非', hint: '与门取反' },
  { kind: 'NOR', label: '或非', hint: '或门取反' },
  { kind: 'XOR', label: '异或', hint: '不同为 1' },
  { kind: 'XNOR', label: '同或', hint: '相同为 1' },
];
---

<BaseLayout
  title="逻辑电路实验台"
  description="拖拽门电路、连线，实时生成真值表与布尔表达式。适合数字逻辑入门与调试。"
  wide
  flush
  bare
>
  <!-- ============ 全屏工作台外壳 ============ -->
  <div class="lc-shell">
    <!-- 极简顶栏 -->
    <header class="lc-topbar">
      <a href="/projects" class="lc-back" title="返回项目列表">
        <Icon name="lucide:arrow-left" class="h-4 w-4" />
        <span>项目</span>
      </a>
      <h1 class="lc-title">
        <Icon name="lucide:circuit-board" class="h-4 w-4 text-brand-400" />
        逻辑电路实验台
      </h1>

      <div class="lc-topbar-tools">
        <button type="button" data-act="undo" title="撤销 (Ctrl+Z)" class="lc-btn lc-btn-sm" disabled>
          <Icon name="lucide:rotate-ccw" class="h-3.5 w-3.5" />
        </button>
        <button type="button" data-act="redo" title="重做 (Ctrl+Shift+Z)" class="lc-btn lc-btn-sm" disabled>
          <Icon name="lucide:rotate-cw" class="h-3.5 w-3.5" />
        </button>
        <span class="lc-sep"></span>
        <button type="button" data-act="preset" title="载入示例电路" class="lc-btn lc-btn-sm">
          <Icon name="lucide:book-open" class="h-3.5 w-3.5" />
        </button>
        <button type="button" data-act="custom" title="自定义黑盒元件" class="lc-btn lc-btn-sm">
          <Icon name="lucide:square-pen" class="h-3.5 w-3.5" />
        </button>
        <button type="button" data-act="import" title="导入电路 JSON" class="lc-btn lc-btn-sm">
          <Icon name="lucide:upload" class="h-3.5 w-3.5" />
        </button>
        <button type="button" data-act="export" title="导出电路 JSON" class="lc-btn lc-btn-sm">
          <Icon name="lucide:download" class="h-3.5 w-3.5" />
        </button>
        <button type="button" data-act="clear" title="清空画布" class="lc-btn lc-btn-sm lc-btn-danger">
          <Icon name="lucide:trash-2" class="h-3.5 w-3.5" />
        </button>
      </div>
    </header>

    <!-- 画布区 -->
    <main class="lc-stage">
      <div id="canvas" class="lc-canvas"></div>

      <div class="lc-empty" id="canvas-empty" hidden>
        <Icon name="lucide:mouse-pointer-click" class="h-5 w-5" />
        点右上角「元件」打开元件库，拖一个进来开始
      </div>

      <!-- 画布左下角：模式提示 + 收敛状态 -->
      <div class="lc-stage-foot">
        <span class="lc-status" id="status">
          <span class="lc-dot"></span>
          <span id="status-text">就绪</span>
        </span>
        <span class="lc-zoom" id="zoom-label">100%</span>
      </div>

      <!-- 画布右下角：缩放控制 -->
      <div class="lc-zoom-ctl">
        <button type="button" data-act="zoom-out" title="缩小" class="lc-btn lc-btn-sm">
          <Icon name="lucide:zoom-out" class="h-3.5 w-3.5" />
        </button>
        <button type="button" data-act="zoom-in" title="放大" class="lc-btn lc-btn-sm">
          <Icon name="lucide:zoom-in" class="h-3.5 w-3.5" />
        </button>
        <button type="button" data-act="fit" title="缩放到刚好装下" class="lc-btn lc-btn-sm">
          <Icon name="lucide:maximize" class="h-3.5 w-3.5" />
        </button>
        <button type="button" data-act="reset-view" title="回到默认视角" class="lc-btn lc-btn-sm">
          <Icon name="lucide:crosshair" class="h-3.5 w-3.5" />
        </button>
      </div>

      <!-- 底部面板开关（左下角，状态栏左侧） -->
      <button type="button" class="lc-panel-toggle" id="bottom-toggle" aria-expanded="false">
        <Icon name="lucide:panel-bottom-open" class="h-4 w-4" />
        <span>真值表 / 波形</span>
      </button>

      <!-- 元件库抽屉（右上角折叠） -->
      <button type="button" class="lc-drawer-toggle" id="palette-toggle" aria-expanded="false">
        <Icon name="lucide:boxes" class="h-4 w-4" />
        <span>元件</span>
      </button>

      <aside class="lc-drawer lc-drawer-right" id="palette-drawer" hidden>
        <div class="lc-drawer-head">
          <h2>元件库</h2>
          <button type="button" class="lc-btn lc-btn-sm" data-act="close-palette" title="收起">
            <Icon name="lucide:x" class="h-3.5 w-3.5" />
          </button>
        </div>
        <div class="lc-drawer-body">
          <p class="lc-hint mb-2">拖到画布上，或点击直接放置</p>
          <div id="palette" class="lc-palette"></div>
        </div>
      </aside>

      <!-- 右侧检查器抽屉 -->
      <aside class="lc-drawer lc-drawer-right lc-drawer-narrow" id="inspector-drawer" hidden>
        <div class="lc-drawer-head">
          <h2>检视</h2>
          <button type="button" class="lc-btn lc-btn-sm" data-act="close-inspector" title="关闭">
            <Icon name="lucide:x" class="h-3.5 w-3.5" />
          </button>
        </div>
        <div class="lc-drawer-body" id="inspector-body" aria-live="polite">
          <p class="lc-hint">点画布上的元件，这里可以改名字、调端口数、改开关状态。</p>
        </div>
      </aside>

      <!-- 底部面板：真值表 / 波形 / 表达式 -->
      <section class="lc-bottom" id="bottom-panel" hidden>
        <div class="lc-bottom-tabs">
          <button type="button" class="lc-tab is-active" data-tab="wave">波形</button>
          <button type="button" class="lc-tab" data-tab="table">真值表</button>
          <button type="button" class="lc-tab" data-tab="expr">表达式</button>
          <span class="flex-1"></span>
          <span class="lc-badge" id="tt-badge"></span>
          <button type="button" class="lc-btn lc-btn-sm" data-act="close-bottom" title="收起面板">
            <Icon name="lucide:chevron-down" class="h-3.5 w-3.5" />
          </button>
        </div>

        <!-- 波形模式 -->
        <div class="lc-bottom-body" data-pane="wave">
          <div class="lc-transport">
            <button type="button" data-act="sim-reset" title="重置" class="lc-btn lc-btn-sm">
              <Icon name="lucide:rotate-ccw" class="h-3.5 w-3.5" />
            </button>
            <button type="button" data-act="sim-step" title="单步（空格）" class="lc-btn lc-btn-primary">
              <Icon name="lucide:step-forward" class="h-3.5 w-3.5" />
              <span class="text-xs">单步</span>
            </button>
            <button type="button" data-act="sim-run" title="连续运行" class="lc-btn lc-btn-sm" id="sim-run-btn">
              <Icon name="lucide:play" class="h-3.5 w-3.5" />
              <span class="text-xs" id="sim-run-label">运行</span>
            </button>
            <select id="sim-speed" class="lc-select" title="运行速度" aria-label="运行速度">
              <option value="1200">0.5×</option>
              <option value="600" selected>1×</option>
              <option value="300">2×</option>
              <option value="120">4×</option>
            </select>
            <span class="lc-hint ml-2" id="sim-info">共 0 步</span>
          </div>
          <p class="lc-mode-hint" id="mode-hint" hidden></p>
          <div class="lc-wave" id="wave-host"></div>
        </div>

        <!-- 真值表模式 -->
        <div class="lc-bottom-body" data-pane="table" hidden>
          <div class="lc-table-wrap" id="tt-wrap">
            <p class="lc-hint p-3">先放几个输入和输出元件。</p>
          </div>
        </div>

        <!-- 表达式模式 -->
        <div class="lc-bottom-body" data-pane="expr" hidden>
          <div class="lc-expr-toolbar">
            <label class="lc-switch">
              <input type="checkbox" id="dm-toggle" />
              <span>德摩根归一化<em>把取反全推到输入端</em></span>
            </label>
            <button type="button" data-act="copy-expr" class="lc-btn lc-btn-sm">
              <Icon name="lucide:copy" class="h-3.5 w-3.5" />
              <span class="text-xs">复制</span>
            </button>
          </div>
          <div id="expr-body">
            <p class="lc-hint">连好电路后这里会显示推导出的表达式。</p>
          </div>
          <p class="lc-verify" id="verify" hidden></p>
        </div>
      </section>

      <!-- 移动端底部 tab 抽屉 -->
      <nav class="lc-mobile-tabs" id="mobile-tabs">
        <button type="button" class="lc-mtab" data-mtab="palette">
          <Icon name="lucide:boxes" class="h-4 w-4" />
          <span>元件</span>
        </button>
        <button type="button" class="lc-mtab" data-mtab="wave">
          <Icon name="lucide:activity" class="h-4 w-4" />
          <span>波形</span>
        </button>
        <button type="button" class="lc-mtab" data-mtab="table">
          <Icon name="lucide:table-2" class="h-4 w-4" />
          <span>真值表</span>
        </button>
        <button type="button" class="lc-mtab" data-mtab="expr">
          <Icon name="lucide:sigma" class="h-4 w-4" />
          <span>表达式</span>
        </button>
      </nav>
    </main>
  </div>

  <!-- ============ Toast ============ -->
  <!-- ============ 示例电路弹窗 ============ -->
  <dialog id="dlg-preset" class="lc-dlg">
    <form method="dialog" class="lc-dlg-inner">
      <h3 class="lc-dlg-title">载入示例电路</h3>
      <p class="lc-hint mb-3">会覆盖当前画布内容（可以用撤销找回）。</p>
      <div id="preset-list" class="lc-dlg-list"></div>
      <div class="lc-dlg-foot">
        <span class="flex-1"></span>
        <button type="button" class="lc-btn" data-close>取消</button>
      </div>
    </form>
  </dialog>

  <!-- ============ 自定义黑盒弹窗 ============ -->
  <dialog id="dlg-custom" class="lc-dlg">
    <form method="dialog" class="lc-dlg-inner lc-dlg-wide">
      <h3 class="lc-dlg-title">自定义黑盒元件</h3>
      <p class="lc-hint mb-3">
        填一张真值表，就多一个自己的元件。存在浏览器本地（localStorage），刷新不丢，也能导出备份。
      </p>

      <div class="lc-form-grid">
        <label class="lc-field">
          <span>元件名称</span>
          <input type="text" id="cx-name" placeholder="例如：2:1 选择器" maxlength="24" />
        </label>
        <label class="lc-field">
          <span>输入端口数</span>
          <select id="cx-in">
            <option value="1">1</option>
            <option value="2" selected>2</option>
            <option value="3">3</option>
            <option value="4">4</option>
          </select>
        </label>
        <label class="lc-field">
          <span>输出端口数</span>
          <select id="cx-out">
            <option value="1" selected>1</option>
            <option value="2">2</option>
          </select>
        </label>
      </div>

      <p class="lc-hint mt-3 mb-1">真值表（点格子切换 0 / 1）</p>
      <div class="lc-tt-editor" id="cx-table"></div>

      <p class="lc-error" id="cx-error" hidden></p>

      <div class="lc-dlg-foot">
        <button type="button" class="lc-btn" id="cx-export">导出元件库</button>
        <button type="button" class="lc-btn" id="cx-import">导入元件库</button>
        <span class="flex-1"></span>
        <button type="button" class="lc-btn" data-close>取消</button>
        <button type="button" class="lc-btn lc-btn-primary" id="cx-save">保存元件</button>
      </div>

      <div class="lc-dlg-sep"></div>
      <h4 class="lc-dlg-subtitle">已保存的元件</h4>
      <div id="cx-list" class="lc-dlg-list"></div>
    </form>
  </dialog>

  <!-- ============ Toast ============ -->

</BaseLayout>

<style is:global>
  /* ==================================================================
     逻辑电路实验台 v2 —— 全屏工作台
     布局用 Tailwind 能做的都用 Tailwind，这里只放：
     ① 全屏外壳与抽屉 ② IEC 元件方框符号 ③ 波形图 ④ 画布
     （不用 Astro scoped：画布节点是 JS 运行时创建的，scoped 打不中）
     ================================================================== */

  /* ---------- 外壳：顶栏 + 画布铺满 ---------- */
  .lc-shell {
    display: flex;
    flex-direction: column;
    /* dvh 而非 vh：规避移动端浏览器地址栏导致的高度跳动 */
    height: 100dvh;
    overflow: hidden;
  }

  .lc-topbar {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 48px;
    padding: 0 0.75rem;
    border-bottom: 1px solid rgb(228 228 231 / 0.8);
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(8px);
    z-index: 30;
  }
  .dark .lc-topbar {
    border-color: rgb(39 39 42 / 0.9);
    background: rgb(24 24 27 / 0.9);
  }

  .lc-back {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    color: #71717a;
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: 0.5rem;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .lc-back:hover {
    background: #eff6ff;
    color: #1d4ed8;
  }
  .dark .lc-back:hover {
    background: rgb(30 58 138 / 0.25);
    color: #93c5fd;
  }

  .lc-title {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    color: #18181b;
    white-space: nowrap;
  }
  .dark .lc-title {
    color: #f4f4f5;
  }

  .lc-topbar-tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .lc-sep {
    width: 1px;
    height: 18px;
    background: rgb(228 228 231);
    margin: 0 0.25rem;
  }
  .dark .lc-sep {
    background: #3f3f46;
  }

  .lc-stage {
    position: relative;
    flex: 1;
    min-height: 0;
  }

  /* 画布容器：撑满 stage */
  #canvas,
  .lc-canvas,
  .lc-canvas .lc-viewport,
  .lc-canvas .lc-vp {
    position: absolute;
    inset: 0;
  }

  /* ---------- 状态与缩放控件 ---------- */
  .lc-stage-foot {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    z-index: 12;
    pointer-events: none;
  }
  .lc-status {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.6875rem;
    color: #71717a;
    background: rgb(255 255 255 / 0.85);
    padding: 0.25rem 0.5rem;
    border-radius: 0.5rem;
    border: 1px solid rgb(228 228 231 / 0.8);
    backdrop-filter: blur(6px);
    max-width: min(60vw, 520px);
  }
  .dark .lc-status {
    color: #a1a1aa;
    background: rgb(24 24 27 / 0.85);
    border-color: rgb(39 39 42 / 0.9);
  }
  .lc-status > span:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .lc-status .lc-dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: #22c55e;
  }
  .lc-status.is-warn .lc-dot { background: #f59e0b; }
  .lc-status.is-err .lc-dot { background: #ef4444; }
  .lc-zoom {
    font-size: 0.6875rem;
    color: #a1a1aa;
    font-variant-numeric: tabular-nums;
    background: rgb(255 255 255 / 0.85);
    padding: 0.25rem 0.5rem;
    border-radius: 0.5rem;
    border: 1px solid rgb(228 228 231 / 0.8);
  }
  .dark .lc-zoom {
    background: rgb(24 24 27 / 0.85);
    border-color: rgb(39 39 42 / 0.9);
  }

  .lc-zoom-ctl {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: flex;
    gap: 0.25rem;
    z-index: 12;
  }

  /* ---------- 抽屉（元件库 / 检视） ---------- */
  .lc-drawer-toggle {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 22;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.4375rem 0.75rem;
    border-radius: 0.625rem;
    border: 1px solid rgb(228 228 231);
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: blur(8px);
    font-size: 0.75rem;
    color: #3f3f46;
    cursor: pointer;
    box-shadow: 0 2px 8px -2px rgb(15 23 42 / 0.12);
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .lc-drawer-toggle:hover {
    border-color: #93c5fd;
    color: #1d4ed8;
  }
  .dark .lc-drawer-toggle {
    border-color: #3f3f46;
    background: rgb(39 39 42 / 0.94);
    color: #d4d4d8;
  }
  .dark .lc-drawer-toggle:hover {
    border-color: #1d4ed8;
    color: #93c5fd;
  }

  /* 底部面板开关：左下角，与右上角的元件库按钮对称 */
  .lc-panel-toggle {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 22;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.4375rem 0.75rem;
    border-radius: 0.625rem;
    border: 1px solid rgb(228 228 231);
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: blur(8px);
    font-size: 0.75rem;
    color: #3f3f46;
    cursor: pointer;
    box-shadow: 0 2px 8px -2px rgb(15 23 42 / 0.12);
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .lc-panel-toggle:hover { border-color: #93c5fd; color: #1d4ed8; }
  .lc-panel-toggle[aria-expanded='true'] {
    border-color: #2563eb;
    color: #1d4ed8;
    background: rgb(219 234 254 / 0.9);
  }
  .dark .lc-panel-toggle { border-color: #3f3f46; background: rgb(39 39 42 / 0.94); color: #d4d4d8; }
  .dark .lc-panel-toggle:hover { border-color: #1d4ed8; color: #93c5fd; }
  .dark .lc-panel-toggle[aria-expanded='true'] {
    border-color: #3b82f6; color: #93c5fd; background: rgb(30 58 138 / 0.5);
  }

  /* 抽屉覆盖画布而非挤压：画布宽度不变，元件坐标不需要重算 */
  .lc-drawer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 302px;
    z-index: 20;
    display: flex;
    flex-direction: column;
    background: rgb(255 255 255 / 0.97);
    backdrop-filter: blur(12px);
    border-left: 1px solid rgb(228 228 231);
    box-shadow: -8px 0 24px -12px rgb(15 23 42 / 0.18);
    animation: lc-slide-in 0.18s ease;
  }
  .lc-drawer-narrow {
    width: 288px;
  }
  .dark .lc-drawer {
    background: rgb(24 24 27 / 0.97);
    border-color: #27272a;
    box-shadow: -8px 0 24px -12px rgb(0 0 0 / 0.6);
  }
  @keyframes lc-slide-in {
    from { transform: translateX(12px); opacity: 0; }
  }

  .lc-drawer-head {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid rgb(228 228 231);
  }
  .dark .lc-drawer-head {
    border-color: #27272a;
  }
  .lc-drawer-head h2 {
    font-family: var(--font-display);
    font-size: 0.875rem;
    color: #18181b;
  }
  .dark .lc-drawer-head h2 {
    color: #f4f4f5;
  }

  .lc-drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 0.75rem;
  }

  /* ---------- 底部面板（波形 / 真值表 / 表达式） ---------- */
  .lc-bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 18;
    /* dvh 兜底 min-height：保证矮视口下也能露出足够内容 */
    height: max(38dvh, 260px);
    display: flex;
    flex-direction: column;
    background: rgb(255 255 255 / 0.97);
    backdrop-filter: blur(12px);
    border-top: 1px solid rgb(228 228 231);
    box-shadow: 0 -8px 24px -12px rgb(15 23 42 / 0.15);
    animation: lc-slide-up 0.18s ease;
  }
  .dark .lc-bottom {
    background: rgb(24 24 27 / 0.97);
    border-color: #27272a;
  }
  @keyframes lc-slide-up {
    from { transform: translateY(12px); opacity: 0; }
  }

  .lc-bottom-tabs {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.625rem;
    border-bottom: 1px solid rgb(228 228 231);
  }
  .dark .lc-bottom-tabs {
    border-color: #27272a;
  }
  .lc-tab {
    padding: 0.25rem 0.625rem;
    border-radius: 0.5rem;
    font-size: 0.75rem;
    color: #71717a;
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .lc-tab:hover {
    color: #1d4ed8;
  }
  .lc-tab.is-active {
    background: #2563eb;
    color: #fff;
  }
  .dark .lc-tab.is-active {
    background: #3b82f6;
  }

  .lc-bottom-body {
    flex: 1;
    min-height: 0;
    overflow: auto;
    padding: 0.625rem;
  }

  /* ---------- 通用控件 ---------- */
  .lc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    border-radius: 0.5rem;
    border: 1px solid rgb(228 228 231);
    background: #fff;
    padding: 0.3125rem 0.5rem;
    font-size: 0.75rem;
    color: #52525b;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .lc-btn:hover:not(:disabled) {
    border-color: #93c5fd;
    color: #1d4ed8;
    background: #eff6ff;
  }
  .dark .lc-btn {
    border-color: #3f3f46;
    background: #27272a;
    color: #d4d4d8;
  }
  .dark .lc-btn:hover:not(:disabled) {
    border-color: #1d4ed8;
    color: #93c5fd;
    background: rgb(30 58 138 / 0.25);
  }
  .lc-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .lc-btn-sm { padding: 0.25rem 0.375rem; }
  .lc-btn-primary { background: #2563eb; border-color: #2563eb; color: #fff; }
  .lc-btn-primary:hover:not(:disabled) {
    background: #1d4ed8; border-color: #1d4ed8; color: #fff;
  }
  .lc-btn-danger:hover:not(:disabled) {
    border-color: #fca5a5; color: #dc2626; background: #fef2f2;
  }
  .dark .lc-btn-danger:hover:not(:disabled) {
    border-color: #7f1d1d; color: #fca5a5; background: rgb(127 29 29 / 0.25);
  }

  .lc-select {
    border-radius: 0.5rem;
    border: 1px solid rgb(228 228 231);
    background: #fff;
    padding: 0.25rem 0.375rem;
    font-size: 0.75rem;
    color: #52525b;
    cursor: pointer;
  }
  .dark .lc-select {
    border-color: #3f3f46; background: #27272a; color: #d4d4d8;
  }

  .lc-hint { font-size: 0.6875rem; line-height: 1.6; color: #71717a; }
  .dark .lc-hint { color: #a1a1aa; }

  .lc-badge {
    font-size: 0.6875rem;
    padding: 0.125rem 0.4375rem;
    border-radius: 9999px;
    background: rgb(239 246 255);
    color: #1d4ed8;
    white-space: nowrap;
  }
  .dark .lc-badge { background: rgb(30 58 138 / 0.35); color: #93c5fd; }

  .lc-transport { display: flex; align-items: center; gap: 0.375rem; flex-wrap: wrap; }

  .lc-mode-hint {
    margin-top: 0.5rem;
    padding: 0.375rem 0.625rem;
    border-radius: 0.5rem;
    background: rgb(255 251 235);
    border: 1px solid rgb(253 224 71);
    font-size: 0.6875rem;
    line-height: 1.6;
    color: #854d0e;
  }
  .dark .lc-mode-hint {
    background: rgb(113 63 18 / 0.25);
    border-color: rgb(133 77 14);
    color: #fde68a;
  }

  .lc-empty {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: #a1a1aa;
    pointer-events: none;
    z-index: 5;
  }

  /* ==================================================================
     元件库面板
     ================================================================== */
  .lc-palette { display: flex; flex-direction: column; gap: 0.625rem; }
  .lc-palette-group { display: flex; flex-direction: column; gap: 0.25rem; }
  .lc-palette-title {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #a1a1aa;
    text-transform: uppercase;
    padding: 0.125rem 0.25rem;
  }

  .lc-chip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 0.5rem;
    border: 1px solid rgb(228 228 231);
    background: #fff;
    padding: 0.375rem 0.5rem;
    cursor: grab;
    user-select: none;
    text-align: left;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .lc-chip:hover {
    border-color: #93c5fd;
    background: #eff6ff;
  }
  .lc-chip:active { cursor: grabbing; }
  .dark .lc-chip { border-color: #3f3f46; background: #27272a; }
  .dark .lc-chip:hover { border-color: #1d4ed8; background: rgb(30 58 138 / 0.25); }

  .lc-chip-text { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; }
  .lc-chip-text b { font-size: 0.75rem; font-weight: 500; color: #3f3f46; }
  .dark .lc-chip-text b { color: #e4e4e7; }
  .lc-chip-text i {
    font-size: 0.625rem; font-style: normal; color: #a1a1aa;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .lc-chip.is-btn { width: 100%; font: inherit; }

  /* chip 里的迷你元件符号 */
  .lc-chip-sym {
    flex: none;
    width: 34px;
    height: 22px;
    display: grid;
    place-items: center;
    border: 1.5px solid var(--ink);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    position: relative;
  }
  .lc-chip-sym[data-shape='mux'] { clip-path: polygon(0 22%, 100% 0, 100% 100%, 0 78%); }
  .lc-chip-sym[data-shape='io'] { border-radius: 999px; width: 26px; }
  .lc-chip-sym[data-bubble='out']::after {
    content: ''; position: absolute; right: -4px; top: 50%;
    width: 5px; height: 5px; margin-top: -2.5px;
    border: 1.5px solid var(--ink); border-radius: 999px; background: #fff;
  }
  .dark .lc-chip-sym[data-bubble='out']::after { background: #18181b; }

  /* ==================================================================
     画布
     ================================================================== */
  .lc-viewport {
    position: relative;
    overflow: hidden;
    /* 双层网格，background-size 由 JS 按缩放同步 */
    background-image:
      linear-gradient(to right, rgb(191 219 254 / 0.35) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(191 219 254 / 0.35) 1px, transparent 1px),
      linear-gradient(to right, rgb(147 197 253 / 0.4) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(147 197 253 / 0.4) 1px, transparent 1px);
    background-size:
      var(--lc-grid, 24px) var(--lc-grid, 24px),
      var(--lc-grid, 24px) var(--lc-grid, 24px),
      var(--lc-grid2, 120px) var(--lc-grid2, 120px),
      var(--lc-grid2, 120px) var(--lc-grid2, 120px);
    background-color: #fafafa;
    touch-action: none;
    cursor: grab;
  }
  .dark .lc-viewport {
    background-image:
      linear-gradient(to right, rgb(63 63 70 / 0.4) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(63 63 70 / 0.4) 1px, transparent 1px),
      linear-gradient(to right, rgb(82 82 91 / 0.55) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(82 82 91 / 0.55) 1px, transparent 1px);
    background-color: #09090b;
  }
  .lc-viewport.is-panning { cursor: grabbing; }

  .lc-vp { position: absolute; inset: 0; overflow: hidden; }
  .lc-world {
    position: absolute; top: 0; left: 0;
    transform-origin: 0 0; will-change: transform;
  }
  .lc-wires {
    position: absolute; top: 0; left: 0;
    overflow: visible; pointer-events: none;
  }
  .lc-nodes { position: absolute; top: 0; left: 0; }

  /* ---------- 连线 ---------- */
  .lc-wire {
    fill: none; stroke: #a1a1aa; stroke-width: 2;
    stroke-linecap: round; pointer-events: none;
    transition: stroke 0.15s ease;
  }
  .dark .lc-wire { stroke: #71717a; }
  .lc-wire.is-selected { stroke: #2563eb; stroke-width: 3; }
  .dark .lc-wire.is-selected { stroke: #60a5fa; }
  .lc-wire.is-temp { stroke: #60a5fa; stroke-dasharray: 5 4; }
  /* 波形游标：信号为 1 的线流动起来 */
  .lc-wire.is-hot {
    stroke: #2563eb; stroke-width: 3;
    stroke-dasharray: 7 5;
    animation: lc-flow 0.55s linear infinite;
  }
  .dark .lc-wire.is-hot { stroke: #60a5fa; }
  @keyframes lc-flow { to { stroke-dashoffset: -12; } }
  @media (prefers-reduced-motion: reduce) {
    .lc-wire.is-hot { animation: none; }
  }
  /* 加粗透明命中层，让细线好点中 */
  .lc-wire-hit {
    fill: none; stroke: transparent; stroke-width: 16;
    pointer-events: stroke; cursor: pointer;
  }

  /* ==================================================================
     IEC 元件方框
     统一矩形框 + 框内限定符，20+ 元件风格一致
     ================================================================== */
  .lc-node {
    position: absolute;
    border-radius: 4px;
    border: 1.5px solid var(--ink);
    background: var(--box-fill);
    display: grid;
    place-items: center;
    cursor: grab;
    user-select: none;
    --ink: #71717a;
    --box-fill: #fff;
    transition: border-color 0.12s ease, box-shadow 0.12s ease;
  }
  .dark .lc-node { --ink: #a1a1aa; --box-fill: #18181b; }
  .lc-node:active { cursor: grabbing; }
  .lc-node:hover { border-color: #2563eb; }
  .lc-node.is-selected {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgb(37 99 235 / 0.2);
  }
  .dark .lc-node.is-selected { border-color: #60a5fa; box-shadow: 0 0 0 3px rgb(59 130 246 / 0.28); }
  .lc-node.is-cycle { border-color: #ef4444; --box-fill: #fef2f2; }
  .dark .lc-node.is-cycle { border-color: #dc2626; --box-fill: rgb(127 29 29 / 0.3); }
  .lc-node.is-pinned { opacity: 0.62; border-style: dashed; }

  /* 拖动把手：铺满整块，不挡端口 */
  .lc-node-grab { position: absolute; inset: 0; z-index: 0; }

  /* 框内限定符 */
  .lc-sym-qual {
    position: relative;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
    color: var(--ink);
    pointer-events: none;
    text-align: center;
  }
  .lc-node[data-type-note] .lc-sym-qual { font-size: 0.75rem; }

  /* 框下方的自定义名 */
  .lc-sym-caption {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-top: 1px;
    font-size: 0.5625rem;
    line-height: 1.2;
    color: #a1a1aa;
    white-space: nowrap;
    pointer-events: none;
    z-index: 1;
  }

  /* 开关 / 常量：值直接写框内，点亮时高亮 */
  .lc-node.is-on {
    --ink: #2563eb;
    --box-fill: rgb(219 234 254 / 0.6);
  }
  .dark .lc-node.is-on {
    --ink: #60a5fa;
    --box-fill: rgb(30 58 138 / 0.4);
  }

  /* IO 类：圆角端子。端子不该像逻辑门那么大，靠 bench 缩小盒子 */
  .lc-node[data-shape='io'] {
    border-radius: 999px;
    justify-content: center;
  }
  .lc-node[data-shape='io'] .lc-sym-qual {
    font-size: 0.75rem;
    font-weight: 700;
  }

  /* MUX：梯形（左窄右宽的梯形） */
  .lc-node[data-shape='mux'] {
    border: none;
    background: transparent;
  }
  .lc-node[data-shape='mux']::before {
    content: '';
    position: absolute; inset: 0;
    background: var(--box-fill);
    border: 1.5px solid var(--ink);
    clip-path: polygon(0 26%, 100% 0, 100% 100%, 0 74%);
  }

  /* 译码器：左侧斜边 */
  .lc-node[data-shape='decoder'] {
    border: none;
    background: transparent;
  }
  .lc-node[data-shape='decoder']::before {
    content: '';
    position: absolute; inset: 0;
    background: var(--box-fill);
    border: 1.5px solid var(--ink);
    clip-path: polygon(0 0, 100% 8%, 100% 92%, 0 100%);
  }

  /* 时序元件：底部一道横线（延迟符号） */
  .lc-node[data-shape='latch']::after,
  .lc-node[data-late]::after {
    content: '';
    position: absolute;
    left: 6px; right: 6px;
    bottom: 4px;
    height: 1.5px;
    background: var(--ink);
  }

  /* 反相小圆（输出端） */
  .lc-node[data-bubble='out']::before {
    content: '';
    position: absolute;
    right: -4px; top: 50%;
    width: 7px; height: 7px;
    margin-top: -3.5px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: var(--box-fill);
    z-index: 2;
  }

  /* 时序元件的 CLK 端口画一道斜线标记 */
  .lc-port.clk-port::before {
    content: '';
    position: absolute;
    left: -5px; top: -3px;
    width: 8px; height: 7px;
    border-top: 1.5px solid currentColor;
    transform: skewY(-30deg);
    opacity: 0.55;
  }

  /* 值徽标：放左下角，避开输出端的小圆与标签 */
  .lc-node-val {
    position: absolute;
    bottom: -8px; left: -6px;
    min-width: 18px; height: 18px;
    padding: 0 4px;
    border-radius: 9999px;
    font-size: 0.6875rem; font-weight: 600;
    line-height: 18px; text-align: center;
    pointer-events: none;
    z-index: 3;
  }
  .lc-node-val.v1 { background: #2563eb; color: #fff; box-shadow: 0 0 0 2px var(--box-fill); }
  .dark .lc-node-val.v1 { background: #3b82f6; box-shadow: 0 0 0 2px #18181b; }
  .lc-node-val.v0 { background: #e4e4e7; color: #71717a; box-shadow: 0 0 0 2px var(--box-fill); }
  .dark .lc-node-val.v0 { background: #3f3f46; color: #a1a1aa; box-shadow: 0 0 0 2px #18181b; }

  /* ---------- 端口 ---------- */
  .lc-port {
    position: absolute;
    width: 11px; height: 11px;
    margin: -5.5px 0 0 -5.5px;
    border-radius: 9999px;
    border: 2px solid var(--box-fill);
    background: #a1a1aa;
    cursor: crosshair;
    z-index: 4;
    color: var(--ink);
    transition: transform 0.12s ease, background 0.12s ease;
  }
  .dark .lc-port { border-color: #18181b; background: #71717a; }
  .lc-port:hover { transform: scale(1.4); background: #2563eb; }
  .lc-port-in { background: #fff; border-color: #a1a1aa; }
  .dark .lc-port-in { background: #18181b; border-color: #71717a; }
  .lc-port-in.is-open {
    background: var(--box-fill);
    border-style: dashed;
    border-color: #d4d4d6;
  }
  .dark .lc-port-in.is-open { border-color: #52525b; }
  .lc-port-out { background: #2563eb; }
  .dark .lc-port-out { background: #60a5fa; }
  /* 加大命中区，不改变视觉大小 */
  .lc-port::after {
    content: ''; position: absolute; inset: -7px; border-radius: 9999px;
  }

  /* ---------- 端口标签 ---------- */
  /* 端口标签放在端口「外侧」，不压在圆点上 */
  .lc-port-label {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-style: normal;
    line-height: 1;
    color: #a1a1aa;
    pointer-events: none;
    z-index: 3;
    white-space: nowrap;
    /* 输入侧：向右让开圆点（+8px）；transform 让文字左边缘起点在这里 */
    transform: translate(8px, -50%);
  }
  .lc-port-label-out {
    /* 输出侧：向左让开圆点 */
    transform: translate(calc(-100% - 8px), -50%);
  }
  /* 选择位用品牌色区分 */
  .lc-port-label.is-sel { color: #2563eb; font-weight: 600; }
  .dark .lc-port-label.is-sel { color: #60a5fa; }
  /* 端口数多时（小圆上只显示部分）隐藏标签，避免糊成一团 */
  .lc-node[data-dense='1'] .lc-port-label { display: none; }

  /* ==================================================================
     真值表
     ================================================================== */
  .lc-table-wrap {
    overflow: auto;
    max-height: 100%;
    border-radius: 0.5rem;
    border: 1px solid rgb(228 228 231);
  }
  .dark .lc-table-wrap { border-color: #27272a; }
  .lc-table-wrap table {
    width: 100%; border-collapse: collapse;
    font-size: 0.75rem; font-variant-numeric: tabular-nums;
  }
  .lc-table-wrap thead th {
    position: sticky; top: 0; z-index: 1;
    background: #f4f4f5; color: #52525b;
    font-weight: 500; padding: 0.3125rem 0.625rem;
    text-align: center; white-space: nowrap;
  }
  .dark .lc-table-wrap thead th { background: #27272a; color: #d4d4d8; }
  .lc-table-wrap thead th.is-input { color: #1d4ed8; }
  .dark .lc-table-wrap thead th.is-input { color: #93c5fd; }
  .lc-table-wrap thead th.is-output { color: #059669; }
  .dark .lc-table-wrap thead th.is-output { color: #34d399; }
  .lc-table-wrap tbody td {
    padding: 0.25rem 0.625rem; text-align: center;
    border-top: 1px solid rgb(228 228 231 / 0.8);
    color: #3f3f46;
  }
  .dark .lc-table-wrap tbody td { border-color: rgb(39 39 42 / 0.8); color: #d4d4d8; }
  .lc-table-wrap tbody tr { cursor: pointer; }
  .lc-table-wrap tbody tr:hover td { background: rgb(244 244 245); }
  .dark .lc-table-wrap tbody tr:hover td { background: rgb(39 39 42 / 0.6); }
  .lc-table-wrap tbody tr.is-current td { background: rgb(219 234 254 / 0.6); font-weight: 500; }
  .dark .lc-table-wrap tbody tr.is-current td { background: rgb(30 58 138 / 0.35); }
  .td-in { color: #a1a1aa !important; }
  .td-out { font-weight: 600; color: #059669 !important; }
  .dark .td-out { color: #34d399 !important; }
  .lc-divider { border-left: 2px solid rgb(228 228 231) !important; }
  .dark .lc-divider { border-color: #3f3f46 !important; }

  /* ==================================================================
     波形
     ================================================================== */
  .lc-wave {
    margin-top: 0.5rem;
    display: flex;
    min-height: 0;
    border: 1px solid rgb(228 228 231);
    border-radius: 0.5rem;
    overflow: hidden;
    background: #fff;
  }
  .dark .lc-wave { border-color: #27272a; background: #0c0c0e; }

  .lc-wave-names {
    flex: none;
    position: relative;
    width: 96px;
    border-right: 1px solid rgb(228 228 231);
    background: #fafafa;
  }
  .dark .lc-wave-names { border-color: #27272a; background: #131316; }
  .lc-wave-name {
    position: absolute;
    left: 0; right: 0;
    display: flex;
    align-items: center;
    padding: 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: #52525b;
    background: transparent;
    border: none;
    cursor: default;
    text-align: left;
    overflow: hidden;
  }
  .dark .lc-wave-name { color: #d4d4d8; }
  .lc-wave-name span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .lc-wave-scroll { flex: 1; overflow-x: auto; overflow-y: hidden; }
  .lc-wave-svg { display: block; }

  .lc-wave-tick {
    font-family: var(--font-mono);
    font-size: 9px;
    fill: #a1a1aa;
    text-anchor: middle;
  }
  .lc-wave-grid line { stroke: rgb(228 228 231 / 0.7); stroke-width: 1; }
  .dark .lc-wave-grid line { stroke: rgb(39 39 42 / 0.8); }
  /* miter + butt：数字波形的直角必须是方角 */
  .lc-wave-line {
    fill: none;
    stroke: #2563eb;
    stroke-width: 2;
    stroke-linejoin: miter;
    stroke-miterlimit: 2;
    stroke-linecap: butt;
  }
  .dark .lc-wave-line { stroke: #60a5fa; }
  .lc-wave-cursor {
    fill: rgb(37 99 235 / 0.08);
    stroke: rgb(37 99 235 / 0.25);
    stroke-width: 1;
  }
  .dark .lc-wave-cursor { fill: rgb(59 130 246 / 0.1); stroke: rgb(59 130 246 / 0.3); }

  /* ==================================================================
     表达式
     ================================================================== */
  .lc-expr-toolbar {
    display: flex; align-items: center; justify-content: space-between;
    gap: 0.75rem; margin-bottom: 0.5rem; flex-wrap: wrap;
  }
  .lc-switch { display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.75rem; color: #52525b; }
