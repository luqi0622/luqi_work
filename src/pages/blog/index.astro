---
export const prerender = false;
import BaseLayout from '@/layouts/BaseLayout.astro';
import ShuoPost from '@/components/shuoshuo/ShuoPost.astro';
import ShuoCompose from '@/components/shuoshuo/ShuoCompose.astro';
import ShuoTags from '@/components/shuoshuo/ShuoTags.astro';
import ShuoInteractions from '@/components/shuoshuo/ShuoInteractions.astro';
import ShuoYearTimeline from '@/components/shuoshuo/ShuoYearTimeline.astro';
import ShuoBackTop from '@/components/shuoshuo/ShuoBackTop.astro';
import {
  listPosts,
  listTags,
  getPostTagsMap,
  getReactionsMap,
  getMyReactions,
} from '@/lib/queries';
import { checkAuth } from '@/lib/auth';
import { formatBeijing } from '@/utils/time';

const tag = Astro.url.searchParams.get('tag') ?? undefined;
const sort = Astro.url.searchParams.get('sort') === 'hot' ? 'hot' : 'time';
const isAuthed = checkAuth(Astro.cookies.get('session')?.value, import.meta.env.SESSION_SECRET);
// 博主登录时列表包含私密说说（卡片右上角会标注私密），游客永远看不到
const [posts, tags, tagMap] = await Promise.all([
  listPosts({ tag, sort, isAuthed }),
  listTags(),
  getPostTagsMap(),
]);

// 表态：匿名访客标识存在 vid cookie 中（随机串，非个人信息）
const vid = Astro.cookies.get('vid')?.value;
const [reactionsMap, mine] = await Promise.all([
  getReactionsMap(posts.map((p) => p.id)),
  getMyReactions(vid),
]);

// 按年份分组（置顶独立区 + 年份降序），驱动「迷你时光轴」
const yearOf = (t: number) => Number(formatBeijing(t).slice(0, 4));
const pinnedPosts = posts.filter((p) => p.pinned === 1);
const normalPosts = posts.filter((p) => p.pinned !== 1);
const yearMap = new Map<number, typeof normalPosts>();
for (const p of normalPosts) {
  const y = yearOf(p.t);
  if (!yearMap.has(y)) yearMap.set(y, []);
  yearMap.get(y)!.push(p);
}
const years = [...yearMap.keys()].sort((a, b) => b - a);
---
<BaseLayout
  title="感悟随笔"
  description="感悟随笔：从 2014 年写到现在的心情、亲情、书影、梦想与校园时光，欢迎留言聊聊"
>
  <section class="py-8 sm:py-12">
    <h1 class="flex items-center gap-2.5 text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl dark:text-zinc-100">
      <span class="text-lg leading-none">✏️</span>
      感悟随笔
    </h1>
    <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">
      从 2014 年的 QQ 空间一路写到现在 · 可以匿名回复，也可以点个表态
    </p>

    {
      isAuthed && (
        <div class="mt-6">
          <ShuoCompose />
        </div>
      )
    }

    <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <ShuoTags tags={tags} current={tag} sort={sort} />

      <!-- 排序切换：最新 / 最热 -->
      <div class="flex shrink-0 items-center gap-1 rounded-full border border-zinc-200 bg-white p-1 text-sm dark:border-zinc-700 dark:bg-zinc-900">
        <a
          href={tag ? `/blog?tag=${encodeURIComponent(tag)}` : '/blog'}
          class:list={[
            'rounded-full px-3 py-1.5 transition-colors',
            sort === 'time'
              ? 'bg-brand-600 font-medium text-white'
              : 'text-zinc-500 hover:text-brand-700 dark:text-zinc-400 dark:hover:text-brand-300',
          ]}
          aria-pressed={sort === 'time'}
        >
          🕒 最新
        </a>
        <a
          href={tag ? `/blog?tag=${encodeURIComponent(tag)}&sort=hot` : '/blog?sort=hot'}
          class:list={[
            'rounded-full px-3 py-1.5 transition-colors',
            sort === 'hot'
              ? 'bg-brand-600 font-medium text-white'
              : 'text-zinc-500 hover:text-brand-700 dark:text-zinc-400 dark:hover:text-brand-300',
          ]}
          aria-pressed={sort === 'hot'}
        >
          🔥 最热
        </a>
      </div>
    </div>

    <ShuoYearTimeline years={years} />

    <div class="mt-2 border-l border-zinc-200 pl-5 dark:border-zinc-800">
      {
        pinnedPosts.length > 0 && (
          <div class="mb-4">
            <p class="mb-3 text-xs font-semibold tracking-wide text-amber-600 dark:text-amber-400">置顶</p>
            {pinnedPosts.map((p) => (
              <ShuoPost
                post={p}
                tags={tagMap.get(p.id) ?? []}
                isAuthed={isAuthed}
                reactions={reactionsMap.get(p.id)}
                mine={mine}
              />
            ))}
          </div>
        )
      }
      {
        years.map((y) => (
          <section id={`year-${y}`} class="scroll-mt-20" data-year={y}>
            <h2 class="-ml-5 mb-3 text-sm font-bold tracking-wide text-zinc-400 dark:text-zinc-500">{y}</h2>
            {(yearMap.get(y) || []).map((p) => (
              <ShuoPost
                post={p}
                tags={tagMap.get(p.id) ?? []}
                isAuthed={isAuthed}
                reactions={reactionsMap.get(p.id)}
                mine={mine}
              />
            ))}
          </section>
        ))
      }
    </div>

    {
      posts.length === 0 && (
        <p class="py-20 text-center text-sm text-zinc-400 dark:text-zinc-600">暂无说说</p>
      )
    }
  </section>
</BaseLayout>

<ShuoBackTop />
<ShuoInteractions tags={tags} />
