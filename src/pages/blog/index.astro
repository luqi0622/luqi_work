---
import BaseLayout from '@/layouts/BaseLayout.astro';

const SHUOSHUO_SRC = 'https://qzone-shuoshuo.vercel.app/shuoshuo?embed=1';
const FRAME_ORIGIN = 'https://qzone-shuoshuo.vercel.app';
---

<BaseLayout
  title="随笔"
  description="感悟随笔：从 2014 年写到现在的心情、亲情、书影、梦想与校园时光，欢迎留言聊聊"
>
  <section class="py-12 sm:py-16">
    <h1
      class="flex items-center gap-2.5 font-display text-2xl tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-100"
    >
      <span class="text-lg leading-none">✏️</span>
      感悟随笔
    </h1>
    <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">
      从 2014 年的 QQ 空间一路写到现在 · 可直接在下方写新随笔、给每条留言
    </p>

    <div class="mt-8">
      <iframe
        id="shuoshuo-frame"
        src={SHUOSHUO_SRC}
        title="QQ 空间说说"
        loading="lazy"
        class="w-full border-0"
        style="min-height: 80vh;"></iframe>
    </div>

    <p class="mt-4 text-center text-xs text-zinc-400 dark:text-zinc-600">
      我是主人？<a
        href="https://qzone-shuoshuo.vercel.app/admin"
        target="_blank"
        rel="noopener"
        class="underline transition-colors hover:text-zinc-600 dark:hover:text-zinc-400"
        >点此登录后台</a
      > 后即可在此写新随笔 / 删评论。
    </p>
  </section>
</BaseLayout>

<script>
  const frame = document.getElementById('shuoshuo-frame') as HTMLIFrameElement | null;
  const FRAME_ORIGIN = 'https://qzone-shuoshuo.vercel.app';
  if (frame) {
    window.addEventListener('message', (e: MessageEvent) => {
      if (e.origin !== FRAME_ORIGIN) return;
      const h = e.data && (e.data.__qzShuoshuoHeight as number | undefined);
      if (typeof h === 'number' && h > 0) {
        frame.style.height = h + 'px';
      }
    });
  }
</script>
