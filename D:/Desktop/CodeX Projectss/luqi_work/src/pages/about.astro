---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import { Icon } from 'astro-icon/components';
import { SITE } from '@/config';
import { TIMELINE, MILESTONE_META, SKILL_TREE } from '@/data/profile';

const faqs = [
  {
    q: '这个网站是用什么搭建的？',
    a: 'Astro + Tailwind CSS，部署在 Vercel 上。文章用 Markdown/MDX 写作，随笔栏目数据存放在 Turso 云数据库中。',
  },
  {
    q: '/tianyuanFood 是什么？',
    a: '这是我此前做的一个企业官网练手项目（React + Vite），作为子站保留在这里，可以在「项目」页找到入口。',
  },
  {
    q: '可以转载文章吗？',
    a: '欢迎转载，请注明出处并附上原文链接。学术相关内容如需引用请先与我确认。',
  },
];

// 时间线倒序展示：最新的里程碑在最上面
const milestones = [...TIMELINE].reverse();
---

<BaseLayout title="关于" description={`关于 ${SITE.name}：研究背景、工程经验与正在关注的方向`}>
  <section class="py-10 sm:py-14">
    <h1 class="flex items-center gap-2.5 text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl dark:text-zinc-100">
      <Icon name="lucide:user-round" class="h-7 w-7 text-brand-600 dark:text-brand-400" />
      关于我
    </h1>

    <div class="mt-8 flex flex-col gap-12">
      <!-- 我是谁 -->
      <div>
        <h2 class="mb-4 flex items-center gap-2 text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
          <Icon name="lucide:fingerprint" class="h-5 w-5 text-brand-600 dark:text-brand-400" />
          我是谁
        </h2>
        <div class="prose max-w-none">
          <p>
            你好，我是 {SITE.name}，一名 Researcher & Engineer，专注于光子计算与自动化工具开发。
          </p>
          <p>
            我长期在光子计算领域做研究，日常工作围绕硅基光电子器件的设计与仿真展开——
            用 Lumerical 做波导建模、跑参数扫描、寻找最优结构。大量重复性工作让我养成了一个习惯：
            <strong>凡是做过两遍的事情，就写成自动化脚本</strong>。于是慢慢积累了各种小工具、
            批处理脚本和提效网页。
          </p>
          <p>
            这个网站是我的个人基地：一部分记录研究中的思考与阶段性结果，一部分分享折腾工具的过程，
            也留一块地方放生活里值得记住的碎片。欢迎通过下方的联系方式找我交流。
          </p>
        </div>
      </div>

      <!-- 时间线 / 足迹 -->
      <div>
        <h2 class="mb-5 flex items-center gap-2 text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
          <Icon name="lucide:route" class="h-5 w-5 text-brand-600 dark:text-brand-400" />
          时间线 / 足迹
        </h2>
        <ol class="relative ml-1 space-y-6 border-l border-zinc-200 pl-6 sm:ml-2 sm:pl-8 dark:border-zinc-800">
          {
            milestones.map((m) => {
              const meta = MILESTONE_META[m.kind];
              return (
                <li class="relative">
                  <span
                    class={`absolute top-1.5 -left-[1.9rem] h-3 w-3 rounded-full ring-4 ring-white sm:-left-[2.4rem] dark:ring-zinc-950 ${meta.dot}`}
                    aria-hidden="true"
                  ></span>
                  <div class="flex flex-wrap items-center gap-2">
                    <time class="font-mono text-xs tracking-wide text-zinc-400 dark:text-zinc-500">{m.date}</time>
                    <span class={`inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-[11px] font-medium ${meta.chip}`}>
                      <Icon name={meta.icon} class="h-3 w-3" />
                      {meta.label}
                    </span>
                  </div>
                  <h3 class="mt-1.5 text-[15px] font-semibold text-zinc-900 sm:text-base dark:text-zinc-100">{m.title}</h3>
                  {m.desc && (
                    <p class="mt-1 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">{m.desc}</p>
                  )}
                  {m.tags && m.tags.length > 0 && (
                    <div class="mt-2 flex flex-wrap gap-1.5">
                      {m.tags.map((t) => (
                        <span class="rounded-md bg-zinc-100 px-1.5 py-0.5 text-[11px] text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400">
                          {t}
                        </span>
                      ))}
                    </div>
                  )}
                </li>
              );
            })
          }
        </ol>
      </div>

      <!-- 技能树 -->
      <div>
        <h2 class="mb-5 flex items-center gap-2 text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
          <Icon name="lucide:git-fork" class="h-5 w-5 text-brand-600 dark:text-brand-400" />
          技能树
        </h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {
            SKILL_TREE.map((group) => (
              <div class="card-hover rounded-2xl border border-zinc-200/70 bg-white p-5 sm:p-6 dark:border-zinc-800/70 dark:bg-zinc-900/40">
                <div class="flex items-center gap-2.5">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600 dark:bg-brand-500/10 dark:text-brand-300">
                    <Icon name={group.icon} class="h-[1.15rem] w-[1.15rem]" />
                  </span>
                  <div class="min-w-0">
                    <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">{group.title}</h3>
                    {group.desc && (
                      <p class="mt-0.5 text-xs text-zinc-400 dark:text-zinc-500">{group.desc}</p>
                    )}
                  </div>
                </div>
                <div class="mt-3.5 flex flex-wrap gap-1.5">
                  {group.tags.map((t) => (
                    <span class="rounded-md border border-zinc-200 px-2 py-0.5 text-xs text-zinc-600 dark:border-zinc-700 dark:text-zinc-300">
                      {t}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- FAQ -->
      <div>
        <h2 class="mb-4 flex items-center gap-2 text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
          <Icon name="lucide:circle-help" class="h-5 w-5 text-brand-600 dark:text-brand-400" />
          常见问题
        </h2>
        <div class="space-y-3">
          {
            faqs.map((faq) => (
              <details class="group rounded-xl border border-zinc-200/70 dark:border-zinc-800/70">
                <summary class="flex cursor-pointer items-center justify-between gap-3 p-4 text-sm font-medium text-zinc-700 dark:text-zinc-300">
                  {faq.q}
                  <Icon
                    name="lucide:chevron-down"
                    class="h-4 w-4 shrink-0 text-zinc-400 transition-transform group-open:rotate-180"
                  />
                </summary>
                <p class="px-4 pb-4 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">{faq.a}</p>
              </details>
            ))
          }
        </div>
      </div>

      <!-- 联系方式 -->
      <div>
        <h2 class="mb-4 flex items-center gap-2 text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
          <Icon name="lucide:mail" class="h-5 w-5 text-brand-600 dark:text-brand-400" />
          找到我
        </h2>
        <SocialLinks />
      </div>
    </div>
  </section>
</BaseLayout>
