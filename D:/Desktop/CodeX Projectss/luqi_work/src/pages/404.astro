---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
---

<BaseLayout title="页面不存在" description="404：页面走丢了">
  <section class="flex flex-col items-center justify-center py-24 text-center sm:py-32">
    <Icon name="lucide:file-question" class="h-14 w-14 text-zinc-300 dark:text-zinc-700" />
    <p class="mt-6 text-5xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">404</p>
    <p class="mt-3 text-sm text-zinc-500 dark:text-zinc-400">这个页面走丢了，或者从来没存在过。</p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-md bg-gradient-to-r from-brand-600 to-brand-500 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-gradient-to-r from-brand-600 to-brand-500 dark:bg-gradient-to-r from-brand-600 to-brand-500 dark:hover:bg-brand-400"
    >
      <Icon name="lucide:home" class="h-4 w-4" />
      回到首页
    </a>
  </section>
</BaseLayout>
