---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TOC from '@/components/TOC.astro';
import Comments from '@/components/Comments.astro';
import { Icon } from 'astro-icon/components';
import { formatDate, readingTime } from '@/utils/content';
import { tagStyle, resolveTags } from '@/utils/tags';
import { SITE } from '@/config';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: posts[i - 1] ?? null,
      next: posts[i + 1] ?? null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const minutes = readingTime(post.body ?? '');
// 分类：手动修正优先（见 src/data/tagOverrides.ts）
const tags = resolveTags(post.id, post.data.tags);
---

<BaseLayout title={post.data.title} description={post.data.description} ogType="article">
  <article class="py-12 sm:py-16">
    <!-- 文章头部 -->
    <header class="mx-auto max-w-2xl">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-sm text-zinc-400 dark:text-zinc-500">
        <time datetime={post.data.pubDate.toISOString()} class="flex items-center gap-1.5">
          <Icon name="lucide:calendar" class="h-4 w-4" />
          {formatDate(post.data.pubDate)}
        </time>
        <span class="flex items-center gap-1.5">
          <Icon name="lucide:clock" class="h-4 w-4" />
          {minutes} 分钟阅读
        </span>
      </div>

      <h1
        class="font-display mt-4 text-2xl leading-snug tracking-tight text-zinc-900 sm:text-3xl dark:text-zinc-100"
      >
        {post.data.title}
      </h1>

      <p class="mt-3 text-sm leading-relaxed text-zinc-500 sm:text-base dark:text-zinc-400">
        {post.data.description}
      </p>

      {
        tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <a
                href="/blog"
                class:list={[
                  'rounded-full border px-2.5 py-0.5 text-xs font-medium transition-colors',
                  tagStyle(tag),
                ]}
              >
                #{tag}
              </a>
            ))}
          </div>
        )
      }

      <div class="mt-6 flex items-center gap-3 border-b border-zinc-200/70 pb-6 dark:border-zinc-800/70">
        <img src="/avatar.svg" alt={SITE.author} width="36" height="36" class="rounded-lg" />
        <div class="text-sm">
          <span class="font-medium text-zinc-700 dark:text-zinc-300">{SITE.author}</span>
          <span class="ml-2 text-zinc-400 dark:text-zinc-500">{SITE.tagline}</span>
        </div>
      </div>
    </header>

    <!-- 正文 + 目录 -->
    <div class="mt-10 flex gap-10">
      <div class="prose mx-auto min-w-0 max-w-2xl">
        <Content />
      </div>
      <aside class="sticky top-24 hidden h-fit w-56 shrink-0 lg:block">
        <TOC headings={headings} />
      </aside>
    </div>

    <!-- 上一篇 / 下一篇 -->
    <nav class="mx-auto mt-14 grid max-w-2xl gap-4 border-t border-zinc-200/70 pt-8 sm:grid-cols-2 dark:border-zinc-800/70">
      {
        prev ? (
          <a
            href={`/blog/${prev.id}/`}
            class="group rounded-xl border border-zinc-200/70 p-4 transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-sm dark:border-zinc-800/70 dark:hover:border-brand-700"
          >
            <p class="flex items-center gap-1 text-xs text-zinc-400 dark:text-zinc-500">
              <Icon name="lucide:arrow-left" class="h-3.5 w-3.5" />
              上一篇
            </p>
            <p class="mt-1.5 text-sm font-medium text-zinc-700 transition-colors group-hover:text-brand-600 dark:text-zinc-300 dark:group-hover:text-brand-400">
              {prev.data.title}
            </p>
          </a>
        ) : (
          <div class="hidden sm:block" />
        )
      }
      {
        next && (
          <a
            href={`/blog/${next.id}/`}
            class="group rounded-xl border border-zinc-200/70 p-4 text-right transition-all hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-sm dark:border-zinc-800/70 dark:hover:border-brand-700"
          >
            <p class="flex items-center justify-end gap-1 text-xs text-zinc-400 dark:text-zinc-500">
              下一篇
              <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
            </p>
            <p class="mt-1.5 text-sm font-medium text-zinc-700 transition-colors group-hover:text-brand-600 dark:text-zinc-300 dark:group-hover:text-brand-400">
              {next.data.title}
            </p>
          </a>
        )
      }
    </nav>

    <!-- 评论区 -->
    <div class="mx-auto max-w-2xl">
      <Comments />
    </div>
  </article>
</BaseLayout>
