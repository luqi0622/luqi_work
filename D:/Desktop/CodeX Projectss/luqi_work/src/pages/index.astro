---
export const prerender = false;
import { getCollection } from 'astro:content';
import { SITE, HERO_IMAGE } from '@/config';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ShuoMiniCard from '@/components/shuoshuo/ShuoMiniCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import { Icon } from 'astro-icon/components';
import { listLatestPosts, getPostTagsMap, getReactionsMap } from '@/lib/queries';

// 首页「最新随笔」直接调用随笔栏目（Turso DB）中创建时间最新的 4 条说说，内容与随笔栏目实时同步
const latest = await listLatestPosts(4);
const [latestTagMap, reactionsMap] = await Promise.all([
  getPostTagsMap(),
  getReactionsMap(latest.map((p) => p.id)),
]);

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);
---

<BaseLayout>
  <!-- Hero：左文字 / 右动漫半身像 -->
  <section
    class="relative grid gap-10 py-12 sm:py-16 md:grid-cols-[minmax(0,1fr)_auto] md:items-center"
  >
    <!-- 背景装饰气泡 -->
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div
        class="animate-float-slow absolute -left-10 top-4 h-40 w-40 rounded-full bg-brand-300/25 blur-3xl dark:bg-brand-500/10"
      >
      </div>
      <div
        class="animate-float-slow absolute left-1/3 top-32 h-32 w-32 rounded-full bg-brand-300/25 blur-3xl dark:bg-brand-500/10"
        style="animation-delay: 1.5s"
      >
      </div>
      <div
        class="animate-float-slow absolute -right-4 top-0 h-36 w-36 rounded-full bg-sky-300/20 blur-3xl dark:bg-sky-500/10"
        style="animation-delay: 3s"
      >
      </div>
    </div>

    <!-- 左：文字介绍 -->
    <div>
      <span
        class="inline-flex items-center gap-1.5 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-600 dark:border-brand-900 dark:bg-brand-950/60 dark:text-brand-300"
      >
        <span class="text-sm leading-none">👋</span>
        你好呀，这里是 Luqi 的小站
      </span>

      <h1
        class="text-gradient mt-4 font-display text-4xl leading-tight tracking-tight sm:text-5xl"
      >
        {SITE.tagline}
      </h1>

      <p class="mt-2 text-lg font-medium text-zinc-700 sm:text-xl dark:text-zinc-300">
        {SITE.taglineSub}
      </p>

      <p class="mt-4 max-w-xl text-sm leading-relaxed text-zinc-500 sm:text-base dark:text-zinc-400">
        这里收藏着从 2014 年写到现在的小情绪——开心的、迷茫的、矫情的、认真的，
        一条条说说像时间胶囊，把它们从 QQ 空间搬了过来。
        也记录我正在做的项目与折腾的小工具。随便逛逛，欢迎留言 🌷
      </p>

      <div class="mt-6">
        <SocialLinks />
      </div>
    </div>

    <!-- 右：动漫半身像（替换 public/images/hero-anime.svg 即可换成你的图） -->
    <div class="relative mx-auto w-56 shrink-0 sm:w-64 lg:w-72">
      <div
        class="animate-float-slow absolute -inset-3 -z-10 rounded-[2rem] bg-gradient-to-br from-brand-300/40 via-brand-300/40 to-brand-300/40 blur-xl dark:from-brand-500/20 dark:via-brand-500/20 dark:to-brand-500/20"
        aria-hidden="true"
      >
      </div>
      <img
        src={HERO_IMAGE}
        alt="Luqi 的动漫半身像"
        width="480"
        height="600"
        class="w-full rounded-3xl border-2 border-white/70 bg-white/40 shadow-xl shadow-brand-500/10 backdrop-blur dark:border-zinc-800/70 dark:bg-zinc-900/50 dark:shadow-brand-500/5"
      />
    </div>
  </section>

  <!-- 最新随笔 -->
  <section class="py-10">
    <div class="mb-6 flex items-center justify-between">
      <h2
        class="flex items-center gap-2 font-display text-xl tracking-tight text-zinc-900 sm:text-2xl dark:text-zinc-100"
      >
        <Icon name="lucide:sparkles" class="h-5 w-5 text-brand-400" />
        最新随笔
      </h2>
      <a
        href="/blog"
        class="flex items-center gap-1 text-sm text-zinc-400 transition-colors hover:text-brand-600 dark:hover:text-brand-400"
      >
        查看全部
        <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </a>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {latest.map((post) => <ShuoMiniCard post={post} tags={latestTagMap.get(post.id) ?? []} reactions={reactionsMap.get(post.id)} />)}
    </div>
  </section>

  <!-- 精选项目 -->
  <section class="py-10">
    <div class="mb-6 flex items-center justify-between">
      <h2
        class="flex items-center gap-2 font-display text-xl tracking-tight text-zinc-900 sm:text-2xl dark:text-zinc-100"
      >
        <Icon name="lucide:folder-git-2" class="h-5 w-5 text-brand-400" />
        精选项目
      </h2>
      <a
        href="/projects"
        class="flex items-center gap-1 text-sm text-zinc-400 transition-colors hover:text-brand-600 dark:hover:text-brand-400"
      >
        查看全部
        <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </a>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
