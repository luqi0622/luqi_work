---
/** 右侧浮动「回到顶部」，滚动超过一屏后出现 */
---

<button
  id="back-top"
  type="button"
  class="fixed right-4 bottom-6 z-40 hidden h-10 w-10 items-center justify-center rounded-full border border-zinc-200 bg-white/90 text-zinc-500 shadow-lg backdrop-blur transition-colors hover:border-brand-300 hover:text-brand-600 sm:right-6 dark:border-zinc-700 dark:bg-zinc-900/90 dark:text-zinc-400 dark:hover:border-brand-700 dark:hover:text-brand-300"
  aria-label="回到顶部"
  title="回到顶部"
>
  <svg
    class="h-4 w-4"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="m18 15-6-6-6 6" />
  </svg>
</button>

<script>
  const btn = document.getElementById('back-top');
  if (btn) {
    const sync = () => {
      const show = window.scrollY > 420;
      btn.classList.toggle('hidden', !show);
      btn.classList.toggle('flex', show);
    };
    btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    window.addEventListener('scroll', sync, { passive: true });
    sync();
  }
</script>
