# 会话签名密钥（HMAC-SHA256，构建期读取 import.meta.env.SESSION_SECRET）
SESSION_SECRET=ef7e2802887ff7263ab53669eb3fa0e308275cad796d1b1b2c4884d02eb02f7b

# 管理员登录密码哈希（scrypt，运行期读取 process.env.ADMIN_PASSWORD_HASH）
