{
  "name": "luqi-work-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "luqi.work 个人博客与作品集（Astro + Tailwind CSS），内含 TianYuanFood 子站（/tianyuanFood）与说说后端（Turso）",
  "scripts": {
    "dev": "node scripts/build-tianyuan.mjs --if-missing && astro dev",
    "build": "node scripts/build-tianyuan.mjs && astro build",
    "build:tianyuan": "node scripts/build-tianyuan.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.0",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.4.1",
    "@astrojs/vercel": "^8.0.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/zcool-kuaile": "^5.3.0",
    "@iconify-json/lucide": "^1.2.65",
    "@libsql/client": "^0.15.0",
    "@tailwindcss/vite": "^4.1.14",
    "astro": "^5.13.0",
    "astro-icon": "^1.1.5",
    "katex": "^0.16.22",
    "rehype-katex": "^7.0.1",
    "remark-github-blockquote-alert": "^2.0.0",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.1.14"
  }
}
